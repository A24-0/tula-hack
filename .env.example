# AI service (host port; inside Docker network backend still uses ai-service:8000)
AI_SERVICE_HOST_PORT=8000

# AI service
WHISPER_DEVICE=cpu
WHISPER_MODEL=small
# Optional: retries while downloading the Whisper model (DNS / Hub flakiness)
# WHISPER_LOAD_RETRIES=30
# WHISPER_LOAD_RETRY_DELAY=5
GIGACHAT_API_KEY=

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=3000
